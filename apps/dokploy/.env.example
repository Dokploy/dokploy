# Optional: serve a custom web UI instead of the built-in one.
# Requests outside /api and the WebSocket endpoints are proxied to this URL.
# The UI must expose /dokploy-ui.json with {"name","version","dokploy":"<semver range>"}.
# If the manifest is missing or the range does not match this Dokploy version,
# the built-in UI is served. Takes precedence over DOKPLOY_DISABLE_UI.
# DOKPLOY_UI_URL=http://my-ui:3000
# Optional: serve only the API (/api/*) and WebSockets, without a web UI.
# DOKPLOY_DISABLE_UI=true
