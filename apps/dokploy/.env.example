DATABASE_URL="postgres://dokploy:amukds4wi9001583845717ad2@localhost:5432/dokploy"
PORT=3000
NODE_ENV=development

# QC service (QC_Agent_Tool's `app.service_main`): writes a test plan for each
# deploy of an application that has the QC step enabled.
QC_SERVICE_BASE_URL=
QC_SERVICE_API_KEY=
# How long a deploy waits for the service before giving up (the run is cancelled).
QC_SERVICE_TIMEOUT_SECONDS=900

# Optional: lets the QC service tell Dokploy a run has finished instead of Dokploy
# only polling. CALLBACK_URL is where the service reaches Dokploy; the secret
# must be the same as the service's QC_SERVICE_WEBHOOK_SECRET.
# QC_SERVICE_CALLBACK_URL=https://dokploy.example.com/api/qc/webhook
# QC_SERVICE_WEBHOOK_SECRET=
