{
	"name": "dokploy",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dokploy:setup": "pnpm --filter=dokploy run setup",
		"dokploy:dev": "pnpm --filter=dokploy run dev",
		"dokploy:build": "pnpm --filter=dokploy run build",
		"dokploy:start": "pnpm --filter=dokploy run start",
		"test": "pnpm --filter=dokploy run test",
		"server:script": "pnpm --filter=server run switch:dev",
		"server:dev": "pnpm --filter=server run dev",
		"server:build": "pnpm --filter=server run build",
		"docker:build:canary": "./apps/dokploy/docker/build.sh canary",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "pnpm --filter=dokploy run generate:openapi"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.4.0",
		"dotenv": "16.4.5",
		"esbuild": "0.25.0",
		"lint-staged": "^15.5.2",
		"tsx": "4.22.4"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.4.0",
		"pnpm": ">=9.12.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"overrides": {
			"js-yaml@4": "4.3.2",
			"sharp@<0.35.5": "^0.35.5",
			"esbuild": "0.25.0",
			"better-call": "1.3.7",
			"@better-fetch/fetch": "1.3.1",
			"@ai-sdk/provider-utils@<4.0.33": "4.0.33",
			"@babel/core@<7.29.6": "7.29.6",
			"@grpc/grpc-js@<1.14.5": "1.14.5",
			"@hono/node-server@<1.19.15": "1.19.15",
			"@protobufjs/utf8@<1.1.1": "1.1.1",
			"@rvf/set-get@<7.0.2": "7.0.2",
			"@xmldom/xmldom@<0.8.15": "0.8.15",
			"axios@<1.20.0": "1.20.0",
			"baseline-browser-mapping@<2.11.0": "2.11.0",
			"brace-expansion@<1.1.21": "1.1.21",
			"brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
			"browserslist@<4.28.7": "4.28.7",
			"deepmerge-ts@<8.0.0": "8.0.0",
			"effect@<3.20.0": "3.20.0",
			"fast-copy@<3.1.0": "3.1.0",
			"fast-uri@<3.1.8": "3.1.8",
			"fast-xml-parser@<5.10.1": "5.10.1",
			"form-data@<4.0.6": "4.0.6",
			"h3@<1.15.9": "1.15.9",
			"hono@<4.13.7": "4.13.7",
			"immutable@<3.8.4": "3.8.4",
			"ip-address@<10.7.1": "10.7.1",
			"lodash@<4.18.1": "4.18.1",
			"minimatch@<3.1.4": "3.1.4",
			"minimatch@>=10.0.0 <10.2.3": "10.2.3",
			"mysql2@<3.23.1": "3.23.1",
			"picomatch@<2.3.2": "2.3.2",
			"postcss@<8.5.23": "8.5.23",
			"postcss-selector-parser@<7.1.6": "7.1.6",
			"protobufjs@<7.6.5": "7.6.5",
			"proxy-addr@<2.0.8": "2.0.8",
			"qs@<6.16.0": "6.16.0",
			"source-map-js@<1.2.2": "1.2.2",
			"tar@<7.5.21": "7.5.21",
			"tar-fs@<2.1.4": "2.1.4",
			"undici@>=7.0.0 <7.29.1": "7.29.1",
			"uuid@<11.1.1": "11.1.1",
			"valibot@<1.4.2": "1.4.2",
			"vite@<7.3.5": "7.3.5"
		},
		"peerDependencyRules": {
			"ignoreMissing": [
				"prisma",
				"@prisma/client",
				"@prisma/engines",
				"@electric-sql/pglite",
				"typescript",
				"drizzle-kit"
			]
		},
		"onlyBuiltDependencies": [
			"@scarf/scarf",
			"@tree-sitter-grammars/tree-sitter-yaml",
			"bcrypt",
			"better-sqlite3",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"msgpackr-extract",
			"node-pty",
			"protobufjs",
			"sharp",
			"ssh2",
			"tree-sitter",
			"tree-sitter-json"
		],
		"patchedDependencies": {
			"@better-auth/drizzle-adapter@1.6.23": "patches/@better-auth__drizzle-adapter@1.6.23.patch"
		}
	}
}
